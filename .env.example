SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
APP_ORIGIN=https://your-project.vercel.app
SPOTIFY_CLIENT_ID=your-spotify-developer-client-id

# Self-hosted Ubuntu values. Keep secret keys only in the Supabase Docker
# .env / .env.functions files on the server; never put them in this repo.
APP_PUBLIC_URL=https://myblock.example.com
SELF_HOSTED_SUPABASE_URL=https://myblock.example.com/supabase
SELF_HOSTED_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
APP_ORIGINS=https://myblock.example.com,http://127.0.0.1:8080
